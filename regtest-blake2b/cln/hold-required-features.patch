@@ -77,3 +77,11 @@ tonic-prost-build = "0.14.2"
 
 [dev-dependencies]
 mockall = "0.14.0"
+
+# lightning-types with `option_blake2b` (512/513) as a known feature, as the
+# Bitcoin BLAKE2b network's nodes set it in every invoice: without it the
+# invoices this plugin makes there, and the ones it is paid with, fail to
+# decode (InvalidFeatures). The crate as published, with
+# lightning-types-blake2b.patch applied, in vendor/lightning-types.
+[patch.crates-io]
+lightning-types = { path = "vendor/lightning-types" }
