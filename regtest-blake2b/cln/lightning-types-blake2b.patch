+/// Bitcoin BLAKE2b chain: `option_blake2b` is feature bits 512 (required)
+/// and 513 (optional), the lowest two bits of the ninth 64-bit chunk.
+pub const BLAKE2B_REQUIRED_BIT: usize = 512;
+const BLAKE2B_FEATURE_CHUNK: usize = BLAKE2B_REQUIRED_BIT / 64;
+const BLAKE2B_FEATURE_BITS: u64 = 0b11;
+
+impl<T: sealed::Context> Features<T> {
+	/// Whether `option_blake2b` (bit 512 or 513) is set: the mark a node on
+	/// the Bitcoin BLAKE2b chain puts on what it produces.
+	pub fn supports_blake2b(&self) -> bool {
+		self.flags.get(BLAKE2B_REQUIRED_BIT / 8).map_or(false, |byte| byte & 0b11 != 0)
+	}
+}
